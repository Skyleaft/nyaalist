# ==============================================================================
# Nyaalist Frontend Configuration Template (.env.example)
# ==============================================================================

# Backend API origin URL:
# - In local development: Leave blank to use Vite's automatic reverse proxy (no CORS issues)
# - In standalone production: Specify backend URL e.g. http://localhost:8080 or https://api.yourdomain.com
PUBLIC_API_URL=http://localhost:8080

# Backend WebSocket URL:
# - Leave blank to auto-detect from browser location (e.g. ws://localhost:3000/api/ws)
# - Or explicitly specify backend WS endpoint:
PUBLIC_WS_URL=ws://localhost:8080/api/ws
